  "cards": [
    {
      "dot": "violet",
      "title": "The seam",
      "items": [
        "execute(action, ctx) → Allowed | Denied | Pending | Error",
        "Only the re-entry helper calls it — graph nodes never touch tools or the model",
        "Pending is data, never an exception"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fail-closed (lock 4)",
      "items": [
        "No audit possible → no execution → Error(governance_unavailable)",
        "Error ≠ Denied — accountability keeps them apart",
        "Write-ahead idempotent on (run_id, action_id)"
      ]
    },
    {
      "dot": "rose",
      "title": "Locks that hold",
      "items": [
        "DENY terminal — humans only resolve ESCALATE",
        "Approver = named-key header, recorded in the journal",
        "checkpointer = where the run is · journal = what happened"
      ]
    }
  ]
