# ==============================================================================
# Warden / Aegis Environment Configuration
# Copy this file to .env and configure your local credentials
# ==============================================================================

# LLM Providers (Optional for local testing / Chat agents)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database Settings (Optional: pgserver bundles Postgres automatically if omitted)
# POSTGRES_URI=postgresql://postgres:@localhost:5432/warden
# CONNECTION_STRING=postgresql://user:password@host/database?sslmode=require

# Named Approver Keys for HITL API (alice:key-1,bob:key-2)
WARDEN_APPROVER_KEYS=admin:aegis-secret-key-123

# Cloudflare Clef Safety Gate (Optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sandbox Container Configuration
# WARDEN_SANDBOX_WORKSPACE=D:/tmp
# WARDEN_SANDBOX_IMAGE=python:3.11-slim
